# Supabase Connect -> Session pooler string; use session mode on IPv4 networks.
# Direct database hostnames require IPv6 unless the project has the IPv4 add-on.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Public project values used by Streamlit and the backend token validator
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<public-anon-key>

# Backend only. The free local Ollama models require Ollama running on this machine.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# Optional cloud provider: set AI_PROVIDER=gemini and provide a Gemini API key.
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
PHOENIX_ENDPOINT=
PHOENIX_API_KEY=

# Optional Google sign-in via Supabase Auth. Configure Google in Supabase first.
SUPABASE_GOOGLE_SIGNIN_ENABLED=false
GOOGLE_SIGNIN_REDIRECT_URI=http://localhost:8501

# Optional operation-specific routing.
AI_CHAT_PROVIDER=
AI_EMBEDDING_PROVIDER=
AI_FALLBACK_PROVIDER=
AI_TIMEOUT_SECONDS=30
AI_RETRY_ATTEMPTS=2
AI_RETRY_BASE_SECONDS=0.35
AI_EMBEDDING_CACHE_TTL_SECONDS=900
AI_EMBEDDING_CACHE_MAX_ENTRIES=1024
CORS_ORIGINS=https://<your-streamlit-app>.streamlit.app,http://localhost:8501

# Frontend only
TASKFLOW_API_URL=http://localhost:8000
