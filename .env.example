# Backend runtime
APP_ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<public-anon-key>
CORS_ORIGINS=http://localhost:8501,https://<your-streamlit-app>.streamlit.app

# Central model routing: Gemini is the primary provider. Keys stay on backend.
DEFAULT_AI_PROVIDER=gemini
AI_CHAT_PROVIDER=
AI_COMPLEX_PROVIDER=
AI_IMPORTANT_PROVIDER=
AI_EMBEDDING_PROVIDER=gemini
AI_FALLBACK_PROVIDERS=openrouter,groq
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
AI_TIMEOUT_SECONDS=30
AI_RETRY_ATTEMPTS=2
AI_RETRY_BASE_SECONDS=0.35
AI_FAILURE_THRESHOLD=3
AI_COOLDOWN_SECONDS=60
AI_EMBEDDING_CACHE_TTL_SECONDS=900
AI_EMBEDDING_CACHE_MAX_ENTRIES=1024

# Optional Phoenix OTLP/HTTP receiver. Set base endpoint or /v1/traces URL.
PHOENIX_ENDPOINT=
PHOENIX_API_KEY=
